PORT=3000

TELEGRAM_BOT_TOKEN=123456:abc
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
TELEGRAM_ADMIN_USER_IDS=123456789
TELEGRAM_UPLOAD_FOLDER_PRESETS=other,img/test
BOT_SETTINGS_FILE_PATH=data/bot_settings.json

IMGBED_BASE_URL=https://imgbed.example.com
IMGBED_UPLOAD_TOKEN=your-upload-token
IMGBED_UPLOAD_PATH=/upload

REQUEST_TIMEOUT_MS=10000
RETRY_MAX_ATTEMPTS=3
MAX_UPLOAD_BYTES=20971520
LOG_LEVEL=info

ENABLE_CHANNEL_REPLY=true
CHANNEL_REPLY_TEMPLATE={url}

DEDUP_STORE_TYPE=memory
